#!/bin/bash
# 腾讯云 Web 函数启动脚本
# ---------------------------------------------------------------------------
# 官方要求：
#   1) HTTP 触发的函数必须监听 9000 端口
#   2) 启动命令要用 node 的绝对路径（/var/lang/nodeXX/bin/node），不能只写 node
#   3) 文件必须以 LF 结尾
#
# 另外，腾讯云上传 zip 后代码可能被放进 src/ 下，
# 所以这里用脚本自身所在目录定位，src/ 与根目录两种布局都能起。
export PORT=9000

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
[ -z "$DIR" ] && DIR="."
cd "$DIR" || exit 1

# node 绝对路径：Nodejs 18.x 对应 /var/lang/node18/bin/node
NODE_BIN="/var/lang/node18/bin/node"
if [ ! -x "$NODE_BIN" ]; then
  NODE_BIN="$(command -v node 2>/dev/null)"
fi
if [ -z "$NODE_BIN" ]; then
  echo "[lead] node not found"
  ls -la /var/lang 2>/dev/null
  exit 1
fi

if [ -f "server.js" ]; then
  exec "$NODE_BIN" server.js
elif [ -f "src/server.js" ]; then
  exec "$NODE_BIN" src/server.js
else
  # 出错信息用 ASCII，避免云端 locale 下的编码乱码
  echo "[lead] server.js not found, dir=$DIR"
  ls -la
  exit 1
fi
